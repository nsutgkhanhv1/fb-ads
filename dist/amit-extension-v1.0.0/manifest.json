{
  "manifest_version": 3,
  "name": "AMIT V1 — Ads Check & Super Share",
  "version": "1.0.0",
  "description": "Hệ thống quản lý tài khoản quảng cáo Facebook và Super Share hàng loạt - AMIT V1",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "extension/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "AMIT V1 Manager"
  },
  "background": {
    "service_worker": "extension/background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "declarativeNetRequest",
    "cookies",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://openrouter.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*"
      ],
      "js": [
        "shared/logger.js",
        "shared/constants.js",
        "extension/content-scripts/fb-injector.js",
        "extension/content-scripts/floating-widget.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "shared/constants.js",
        "icons/icon16.png",
        "icons/icon48.png"
      ],
      "matches": [
        "https://*.facebook.com/*"
      ]
    }
  ]
}
